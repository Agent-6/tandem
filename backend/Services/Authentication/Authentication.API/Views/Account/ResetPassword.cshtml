@model Authentication.API.Controllers.ResetPasswordRequest
@{
    ViewData["Title"] = "Reset Password";
}

<div class="w-full max-w-md mx-auto">
    <div class="card">
        <div class="card-header text-center">
            <div class="mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 mx-auto text-foreground">
                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4" />
                </svg>
            </div>
            <h1 class="card-title">Reset your password</h1>
            <p class="card-description">Enter your new password below</p>
        </div>
        <div class="card-content">
            <form asp-action="ResetPassword" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div asp-validation-summary="All" class="alert-destructive mb-4" style="@(ViewContext.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>

                <div class="space-y-4">
                    <div class="space-y-2">
                        <label asp-for="NewPassword" class="label">New Password</label>
                        <input asp-for="NewPassword" class="input-field" type="password" placeholder="••••••••" autocomplete="new-password" autofocus />
                        <span asp-validation-for="NewPassword" class="text-xs text-destructive"></span>
                    </div>

                    <button type="submit" class="btn-primary">
                        Reset Password
                    </button>
                </div>
            </form>
        </div>
        <div class="card-footer flex-col space-y-4">
            <div class="separator"></div>
            <p class="text-sm text-muted-foreground text-center">
                <a href="/Account/Login" class="text-foreground underline underline-offset-4 hover:text-primary transition-colors">
                    Back to sign in
                </a>
            </p>
        </div>
    </div>
</div>
