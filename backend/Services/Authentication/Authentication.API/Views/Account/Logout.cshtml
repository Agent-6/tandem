@{
    ViewData["Title"] = "Sign Out";
}

<div class="w-full max-w-md mx-auto">
    <div class="card">
        <div class="card-header text-center">
            <div class="mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 mx-auto text-muted-foreground">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" x2="9" y1="12" y2="12" />
                </svg>
            </div>
            <h1 class="card-title">Sign out</h1>
            <p class="card-description">Are you sure you want to sign out of your account?</p>
        </div>
        <div class="card-content">
            <form asp-action="LogoutConfirm" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <div class="flex flex-col gap-2">
                    <button type="submit" class="btn-destructive">
                        Yes, sign me out
                    </button>
                    <a href="/" class="btn-outline text-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
