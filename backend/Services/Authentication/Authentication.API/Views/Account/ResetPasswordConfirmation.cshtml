@{
    ViewData["Title"] = "Password Reset";
}

<div class="w-full max-w-md mx-auto">
    <div class="card">
        <div class="card-header text-center">
            <div class="mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 mx-auto text-green-500">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </div>
            <h1 class="card-title">Password reset successful</h1>
            <p class="card-description">Your password has been changed. You can now sign in with your new password.</p>
        </div>
        <div class="card-content">
            <a href="/Account/Login" class="btn-primary inline-block text-center">
                Sign In
            </a>
        </div>
    </div>
</div>
