@{
    ViewData["Title"] = "Check Your Email";
}

<div class="w-full max-w-md mx-auto">
    <div class="card">
        <div class="card-header text-center">
            <div class="mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 mx-auto text-green-500">
                    <path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    <path d="m16 19 2 2 4-4" />
                </svg>
            </div>
            <h1 class="card-title">Check your email</h1>
            <p class="card-description">
                If an account exists with that email address, we&rsquo;ve sent you a password reset link.
                Please check your inbox and spam folder.
            </p>
        </div>
        <div class="card-content">
            <a href="/Account/Login" class="btn-primary inline-block text-center">
                Back to Sign In
            </a>
        </div>
    </div>
</div>
