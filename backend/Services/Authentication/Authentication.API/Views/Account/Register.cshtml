@model Authentication.API.Models.RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="w-full max-w-md mx-auto">
    <div class="card">
        <div class="card-header text-center">
            <div class="mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 mx-auto text-foreground">
                    <path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3" />
                </svg>
            </div>
            <h1 class="card-title">Create an account</h1>
            <p class="card-description">Enter your details below to create your account</p>
        </div>
        <div class="card-content">
            <form asp-action="Register" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="alert-destructive mb-4" style="@(ViewContext.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>

                <div class="space-y-4">
                    <div class="space-y-2">
                        <label asp-for="DisplayName" class="label">Display Name</label>
                        <input asp-for="DisplayName" class="input-field" type="text" placeholder="John Doe" autocomplete="name" autofocus />
                        <span asp-validation-for="DisplayName" class="text-xs text-destructive"></span>
                    </div>

                    <div class="space-y-2">
                        <label asp-for="Email" class="label">Email</label>
                        <input asp-for="Email" class="input-field" type="email" placeholder="name@example.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-xs text-destructive"></span>
                    </div>

                    <div class="space-y-2">
                        <label asp-for="Password" class="label">Password</label>
                        <input asp-for="Password" class="input-field" type="password" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-xs text-destructive"></span>
                    </div>

                    <div class="space-y-2">
                        <label asp-for="ConfirmPassword" class="label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="input-field" type="password" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-xs text-destructive"></span>
                    </div>

                    <button type="submit" class="btn-primary">
                        Create Account
                    </button>
                </div>
            </form>
        </div>
        <div class="card-footer flex-col space-y-4">
            <div class="separator"></div>
            <p class="text-sm text-muted-foreground text-center">
                Already have an account?
                <a href="/Account/Login" class="text-foreground underline underline-offset-4 hover:text-primary transition-colors">
                    Sign in
                </a>
            </p>
        </div>
    </div>
</div>
