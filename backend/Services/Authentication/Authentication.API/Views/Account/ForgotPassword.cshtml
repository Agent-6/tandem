@{
    ViewData["Title"] = "Forgot Password";
}

<div class="w-full max-w-md mx-auto">
    <div class="card">
        <div class="card-header text-center">
            <div class="mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 mx-auto text-muted-foreground">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
            </div>
            <h1 class="card-title">Forgot your password?</h1>
            <p class="card-description">Enter your email address and we&rsquo;ll send you a link to reset your password.</p>
        </div>
        <div class="card-content">
            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div class="space-y-4">
                    <div class="space-y-2">
                        <label for="email" class="label">Email</label>
                        <input name="email" id="email" class="input-field" type="email" placeholder="name@example.com" autocomplete="email" autofocus required />
                    </div>

                    <button type="submit" class="btn-primary">
                        Send Reset Link
                    </button>
                </div>
            </form>
        </div>
        <div class="card-footer flex-col space-y-4">
            <div class="separator"></div>
            <p class="text-sm text-muted-foreground text-center">
                Remember your password?
                <a href="/Account/Login" class="text-foreground underline underline-offset-4 hover:text-primary transition-colors">
                    Back to sign in
                </a>
            </p>
        </div>
    </div>
</div>
